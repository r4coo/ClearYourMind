<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/rounded_edittext_background">

    <TextView
        android:id="@+id/entryDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="italic"
        tools:text="25/05/2024 10:30" />

    <TextView
        android:id="@+id/entryMoodScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Humor: 8/10" />

    <TextView
        android:id="@+id/entryReflection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Hoy fue un día genial. Logré completar todas mis tareas y me sentí muy productivo." />

    <ImageView
        android:id="@+id/entryImage"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@drawable/placeholder_image"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/entryLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Ubicación: Lat: 12.34, Lon: 56.78"
        tools:visibility="visible" />

</LinearLayout>