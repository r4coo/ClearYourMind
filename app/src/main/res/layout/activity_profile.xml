<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabecera del Perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_user_avatar"
                android:background="@drawable/rounded_edittext_background"
                android:padding="16dp"
                app:tint="#555555"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alexis Usuario"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="alexis@ejemplo.com"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Opciones de Configuración -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuración"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btnAccount"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Editar Perfil"
            android:gravity="start|center_vertical"
            android:drawableEnd="@android:drawable/ic_menu_edit"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/btnSecurity"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Seguridad y Privacidad"
            android:gravity="start|center_vertical"
            android:drawableEnd="@android:drawable/ic_lock_lock"
            android:layout_marginBottom="8dp"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/btnNotifications"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Notificaciones"
            android:gravity="start|center_vertical"
            android:drawableEnd="@android:drawable/ic_popup_reminder"
            android:layout_marginBottom="32dp"
            android:textColor="#333333"/>

        <!-- Botón Cerrar Sesión -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar Sesión"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al Diario"
            android:layout_marginTop="8dp"
            android:textColor="#757575"/>

    </LinearLayout>
</ScrollView>